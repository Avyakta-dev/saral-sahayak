# Public, browser-visible API configuration. Never put provider keys or secrets here.
# The URL is the application API prefix, not an LLM provider endpoint.
# Leave empty for explicit local preview mode.
VITE_API_BASE_URL=

# Example development value: http://127.0.0.1:8000/api/v1
# Production requires HTTPS and an explicitly allowed frontend CORS origin.
# Metadata checks are capped at 5 seconds. Analysis timeout: 1,000–300,000 ms.
VITE_API_TIMEOUT_MS=120000
