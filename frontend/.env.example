# Public browser-visible settings only. Never add provider or gateway tokens.
# Application server root (not a provider endpoint and not an /api/v1 prefix).
# Empty means same-origin /api/v1, consistent with shared deployment settings.
VITE_API_BASE_URL=

# Set true only to choose an explicitly offline example-only build.
VITE_PREVIEW_ONLY=false

# Example API root: http://127.0.0.1:8000
# Production requires HTTPS and an explicitly permitted frontend CORS origin.
# Metadata capped at 5 seconds; analysis timeout range 1,000–300,000 ms.
VITE_API_TIMEOUT_MS=120000
