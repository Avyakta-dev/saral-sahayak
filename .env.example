# Copy to .env locally; never commit real keys. No live requests occur at startup.
LLM_API_STYLE=responses
# Supported: responses, chat_completions, messages
# Include your provider prefix, not the final /responses, /chat/completions or /messages endpoint.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
# Internal provider SSE for responses; set false for chat_completions or messages.
# Partial model output stays private; only complete validated answers reach the client.
LLM_STREAM=false
# Must stay <= ANALYSIS_REQUEST_SECONDS (shared request budget). Cap raised to 120 for live retests.
LLM_TIMEOUT_SECONDS=25
# Overall analysis request deadline (BudgetLimits.request_seconds). Default 30; live acceptance may use 60.
ANALYSIS_REQUEST_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=2000
LLM_ANTHROPIC_VERSION=2023-06-01
# JSON mapping for provider-specific headers; reserved auth headers cannot be overridden.
LLM_EXTRA_HEADERS={}
# Exact browser origins only (optional). No wildcards. Vite defaults to 127.0.0.1:5173 — localhost differs.
CORS_ORIGINS=["http://127.0.0.1:5173"]
# JSON array: known, unique codes only; must include en (the unchanged default).
# API acceptance is not translation-quality verification. Capabilities lists enabled codes.
SUPPORTED_LANGUAGES=["en","hi","kn","ta","te","ml"]
# local preserves offline development; use protected behind an approved HTTPS gateway.
ANALYSIS_ACCESS_MODE=local
# Protected mode requires 32-256 printable ASCII characters; generate randomly, never commit.
# Server-to-server only: never put this token in browser code, VITE_* or frontend settings.
ANALYSIS_ACCESS_TOKEN=
# Per-process fixed-window admission limits, not a distributed quota or billing cap.
ANALYSIS_REQUESTS_PER_MINUTE=10
ANALYSIS_MAX_CONCURRENT=2

# Private image input through a private S3-compatible bucket (Cloudflare R2).
# Disabled by default and never inferred from the model name; text-only is unchanged.
IMAGE_INPUT_ENABLED=false
# Set true only after configuring private-bucket lifecycle expiry for inbox/ and validated/.
# URL expiry does not delete objects; this is operator attestation, not an automated audit.
IMAGE_LIFECYCLE_CONFIGURED=false
# Bare HTTPS origin with no path, e.g. https://<account_id>.r2.cloudflarestorage.com
IMAGE_R2_ENDPOINT=
IMAGE_R2_BUCKET=
# Credentials are NOT configured here: they come from the standard boto3 chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or ~/.aws/credentials). Scope the token to
# Object Read & Write on this one bucket. Keep the bucket private — no public access and
# no r2.dev URL. The browser uploads straight to it with a short-lived presigned PUT, so
# the bucket needs a CORS policy allowing PUT from the frontend origins with the
# Content-Type header; without it every upload fails. The configured LLM_MODEL must accept
# image input for the configured LLM_API_STYLE, or extraction fails at the provider.
# Optional bounded limits (defaults shown); a tighter TTL is safer than a longer one.
IMAGE_UPLOAD_TTL_SECONDS=120
IMAGE_URL_MAX_TTL_SECONDS=120
IMAGE_MAX_BYTES=10485760
IMAGE_OCR_MAX_CHARS=8000
IMAGE_OCR_MAX_OUTPUT_TOKENS=1000
IMAGE_CONTENT_TYPES=["image/png","image/jpeg","image/webp"]

# Frontend (Vite). Empty = same-origin relative /api/... paths.
# For local UI against the loopback backend: VITE_API_BASE_URL=http://127.0.0.1:8000
# LLM keys and ANALYSIS_ACCESS_TOKEN stay server-side only — never put them in VITE_* or browser code.
VITE_API_BASE_URL=
