# Copy to .env locally; never commit real keys. No live requests occur at startup.
LLM_API_STYLE=responses
# Supported: responses, chat_completions, messages
# Include your provider prefix, not the final /responses, /chat/completions or /messages endpoint.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
# Must stay <= ANALYSIS_REQUEST_SECONDS (shared request budget). Cap raised to 120 for live retests.
LLM_TIMEOUT_SECONDS=25
# Overall analysis request deadline (BudgetLimits.request_seconds). Default 30; live acceptance may use 60.
ANALYSIS_REQUEST_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=2000
LLM_ANTHROPIC_VERSION=2023-06-01
# JSON mapping for provider-specific headers; reserved auth headers cannot be overridden.
LLM_EXTRA_HEADERS={}
# Exact frontend origins, optional. No wildcard credentials or broad CORS by default.
CORS_ORIGINS=[]
# JSON array: known, unique codes only; must include en (the unchanged default).
# API acceptance is not translation-quality verification. Capabilities lists enabled codes.
SUPPORTED_LANGUAGES=["en","hi","kn","ta","te","ml"]
# local preserves offline development; use protected behind an approved HTTPS gateway.
ANALYSIS_ACCESS_MODE=local
# Protected mode requires 32-256 printable ASCII characters; generate randomly, never commit.
# Server-to-server only: never put this token in browser code, VITE_* or frontend settings.
ANALYSIS_ACCESS_TOKEN=
# Per-process fixed-window admission limits, not a distributed quota or billing cap.
ANALYSIS_REQUESTS_PER_MINUTE=10
ANALYSIS_MAX_CONCURRENT=2

# Frontend (Vite). Empty = same-origin relative /api/... paths.
# For local UI against the loopback backend: VITE_API_BASE_URL=http://127.0.0.1:8000
# LLM keys and ANALYSIS_ACCESS_TOKEN stay server-side only — never put them in VITE_* or browser code.
VITE_API_BASE_URL=
